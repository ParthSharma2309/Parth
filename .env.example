# ==============================================================================
# DocuMind - Environment Configuration Reference (.env.example)
#
# IMPORTANT:
# - Only GEMINI_API_KEY is required in server environments.
# - All other variables are OPTIONAL and have built-in defaults in code.
# - You will never be prompted for optional variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Credentials & App Identity
# ------------------------------------------------------------------------------
# GEMINI_API_KEY (REQUIRED):
# Your Google Gemini API key. In Google AI Studio Build, this is securely injected.
# In local development or standalone Docker containers, obtain one from https://aistudio.google.com/
# Default: (none - required)
GEMINI_API_KEY="AIzaSy..."

# APP_URL (OPTIONAL):
# Public base URL of the running application.
# Default: "http://localhost:3000"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Server Network & Runtime Configuration
# ------------------------------------------------------------------------------
# PORT (OPTIONAL):
# HTTP port for the Express backend and Vite static middleware.
# Default: 3000
PORT="3000"

# HOST (OPTIONAL):
# Network interface to bind to ('0.0.0.0' allows external network requests).
# Default: "0.0.0.0"
HOST="0.0.0.0"

# NODE_ENV (OPTIONAL):
# Execution mode ('development', 'production', or 'test').
# Default: "development"
NODE_ENV="development"

# ALLOWED_ORIGINS (OPTIONAL):
# Comma-separated list of allowed CORS origins (e.g., https://my-documind.com).
# Leave empty to default to same-origin requests with automatic local & preview domain access.
# Default: ""
ALLOWED_ORIGINS=""

# ------------------------------------------------------------------------------
# 3. Model Architecture & Fallback Chains
# ------------------------------------------------------------------------------
# DEFAULT_GEN_MODEL (OPTIONAL):
# The primary Gemini model used for query answering, chat, summarization, and follow-ups.
# Default: "gemini-3.8-flash"
DEFAULT_GEN_MODEL="gemini-3.8-flash"

# DEFAULT_EMBED_MODEL (OPTIONAL):
# The primary Gemini embedding model used for document chunking and vector indexing.
# Default: "gemini-embedding-2-preview"
DEFAULT_EMBED_MODEL="gemini-embedding-2-preview"

# GEN_MODELS (OPTIONAL):
# Comma-separated candidate generation models for automatic failover / retry routing.
# Default: "gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.1-pro-preview,gemini-flash-latest"
GEN_MODELS="gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.1-pro-preview,gemini-flash-latest"

# EMBED_MODELS (OPTIONAL):
# Comma-separated candidate embedding models for indexing and fallback.
# Default: "gemini-embedding-2-preview,gemini-embedding-2,gemini-embedding-001,text-embedding-004"
EMBED_MODELS="gemini-embedding-2-preview,gemini-embedding-2,gemini-embedding-001,text-embedding-004"

# EMBED_DIMENSIONS (OPTIONAL):
# Truncate embedding dimensions (e.g., 768). Reduces client vector storage footprint by 4x.
# Leave empty to use the embedding model's native dimensionality.
# Default: (none - uses model native output dimension)
EMBED_DIMENSIONS=""

# ------------------------------------------------------------------------------
# 4. Route-Specific Timeouts (in milliseconds)
# ------------------------------------------------------------------------------
# TIMEOUT_REWRITE (OPTIONAL):
# Maximum timeout for conversation disambiguation / query rewriting (in milliseconds).
# Default: 15000 (15 seconds)
TIMEOUT_REWRITE="15000"

# TIMEOUT_EMBED (OPTIONAL):
# Maximum timeout for batch vector embedding generation requests (in milliseconds).
# Default: 30000 (30 seconds)
TIMEOUT_EMBED="30000"

# TIMEOUT_GENERATE (OPTIONAL):
# Maximum timeout for answer generation and streaming completions (in milliseconds).
# Default: 60000 (60 seconds)
TIMEOUT_GENERATE="60000"

# TIMEOUT_VISION (OPTIONAL):
# Maximum timeout for OCR and document page image analysis (in milliseconds).
# Default: 90000 (90 seconds)
TIMEOUT_VISION="90000"

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Proxy Protection
# ------------------------------------------------------------------------------
# RATE_LIMIT_PER_MIN (OPTIONAL):
# Global rate limit ceiling per IP address per 1-minute sliding window.
# Default: 60
RATE_LIMIT_PER_MIN="60"

# ------------------------------------------------------------------------------
# 6. Observability & Logging
# ------------------------------------------------------------------------------
# LOG_LEVEL (OPTIONAL):
# Pino structured logging level ('fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent').
# Default: "info"
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 7. Firebase Authentication, Firestore & Cloud Storage (Client & Server)
# ------------------------------------------------------------------------------
# If omitted, DocuMind provides full local guest mode with IndexedDB storage,
# or displays an actionable error guide explaining the required variables.

# VITE_FIREBASE_API_KEY (OPTIONAL - needed for cloud auth & sync):
# Web API Key found in Firebase Console -> Project Settings -> General -> Web apps.
# Default: ""
VITE_FIREBASE_API_KEY=""

# VITE_FIREBASE_AUTH_DOMAIN (OPTIONAL):
# Firebase Auth domain (e.g. <project-id>.firebaseapp.com).
# Default: ""
VITE_FIREBASE_AUTH_DOMAIN=""

# FIREBASE_PROJECT_ID (OPTIONAL):
# Google Cloud / Firebase project ID for server-side ID token verification.
# Default: VITE_FIREBASE_PROJECT_ID or project_id in FIREBASE_SERVICE_ACCOUNT
FIREBASE_PROJECT_ID=""

# VITE_FIREBASE_PROJECT_ID (OPTIONAL):
# Google Cloud / Firebase Project ID.
# Default: ""
VITE_FIREBASE_PROJECT_ID=""

# VITE_FIREBASE_STORAGE_BUCKET (OPTIONAL):
# Google Cloud Storage bucket for PDF documents (e.g. <project-id>.firebasestorage.app).
# Default: ""
VITE_FIREBASE_STORAGE_BUCKET=""

# VITE_FIREBASE_MESSAGING_SENDER_ID (OPTIONAL):
# Firebase Cloud Messaging Sender ID.
# Default: ""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# VITE_FIREBASE_APP_ID (OPTIONAL):
# Firebase Web App ID (e.g. 1:123456789012:web:abcdef123456).
# Default: ""
VITE_FIREBASE_APP_ID=""

# VITE_FIREBASE_MEASUREMENT_ID (OPTIONAL):
# Google Analytics measurement ID (e.g. G-XXXXXXXXXX).
# Default: ""
VITE_FIREBASE_MEASUREMENT_ID=""

# FIREBASE_SERVICE_ACCOUNT (OPTIONAL - Format 1):
# Service account private key JSON (raw string or base64) for server-side firebase-admin verification.
# When provided, takes precedence over discrete client email and private key variables.
# Default: ""
FIREBASE_SERVICE_ACCOUNT=""

# FIREBASE_CLIENT_EMAIL (OPTIONAL - Format 2):
# Service account client email (e.g., firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com).
# Used when FIREBASE_SERVICE_ACCOUNT is omitted.
# Default: ""
FIREBASE_CLIENT_EMAIL=""

# FIREBASE_PRIVATE_KEY (OPTIONAL - Format 2):
# Service account private key PEM (e.g., "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n").
# Used when FIREBASE_SERVICE_ACCOUNT is omitted. Supports escaped "\n" characters.
# Default: ""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 8. Supabase Storage Configuration (Server-Only)
# ------------------------------------------------------------------------------
# SUPABASE_URL (OPTIONAL - needed for cloud document storage):
# The REST/Storage endpoint of your Supabase project (e.g., https://your-project.supabase.co).
# Leave empty to keep document storage in local IndexedDB.
# Default: ""
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY (OPTIONAL - server-only secret):
# The service_role secret key found in Supabase Dashboard -> Project Settings -> API.
# WARNING: NEVER expose this key to the browser, client code, or prefix with VITE_.
# Default: ""
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_STORAGE_BUCKET (OPTIONAL):
# The private Supabase Storage bucket for storing user documents.
# Default: "documents"
SUPABASE_STORAGE_BUCKET="documents"

